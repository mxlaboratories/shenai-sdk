{
  "name": "shenai-sdk-example-js",
  "version": "2.0.0-beta.18",
  "private": true,
  "dependencies": {
    "@shenai/sdk": "3.1.2",
    "serve": "^13.0.2"
  },
  "scripts": {
    "build": "rm -rf build && mkdir build && cp -r src/* build/ && cp -R node_modules/@shenai/sdk build/shenai-sdk",
    "serve": "serve -s build --config=../serve.json",
    "start": "yarn build && yarn serve"
  }
}
