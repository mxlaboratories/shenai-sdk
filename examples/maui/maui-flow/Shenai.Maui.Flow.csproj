<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Shen.AI Flow</ApplicationTitle>
    <ApplicationId>ai.mxlabs.shenai.maui.flow</ApplicationId>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net9.0-android'">26</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net9.0-ios'">13.0</SupportedOSPlatformVersion>
    <AndroidMinSdkVersion Condition="'$(TargetFramework)'=='net9.0-android'">26</AndroidMinSdkVersion>
    <TargetSdkVersion Condition="'$(TargetFramework)'=='net9.0-android'">35</TargetSdkVersion>
    <AndroidTargetSdkVersion Condition="'$(TargetFramework)'=='net9.0-android'">35</AndroidTargetSdkVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ShenaiApiKey Condition="'$(ShenaiApiKey)' == ''">$([System.Environment]::GetEnvironmentVariable('SHENAI_API_KEY'))</ShenaiApiKey>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SHENAI_API_KEY</_Parameter1>
      <_Parameter2>$(ShenaiApiKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-ios'">
    <Registrar>dynamic</Registrar>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net9.0-ios' and '$(Configuration)'=='Debug'">
    <MtouchLink>SdkOnly</MtouchLink>
    <MtouchDebug>false</MtouchDebug>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="Shenai.Maui" Version="3.1.17" />
  </ItemGroup>
  <ItemGroup>
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#000000" BaseSize="128,128" />
  </ItemGroup>
  <Target Name="WipeObjCReferenceSymbols" AfterTargets="_LoadLinkerOutput" BeforeTargets="_LinkNativeExecutable" Condition="'$(TargetFramework)'=='net9.0-ios'">
    <ItemGroup>
      <_ProcessedReferenceNativeSymbol Remove="@(_ProcessedReferenceNativeSymbol)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('_OBJC_CLASS_$_'))" />
    </ItemGroup>
  </Target>
</Project>